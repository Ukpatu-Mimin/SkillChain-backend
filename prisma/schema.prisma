// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USERS / PROFILES
// ─────────────────────────────────────────────

enum UserRole {
  talent
  client
  both
}

enum PreferredCurrency {
  SOL
  USDC
  USDT
}

model Profile {
  id                  String    @id @default(uuid())
  supabaseId          String    @unique // Supabase Auth UID
  name                String
  handle              String    @unique
  email               String    @unique
  avatar              String?
  coverImage          String?
  title               String?
  bio                 String?
  isVerified          Boolean   @default(false)
  walletAddress       String?
  hourlyRateSol       Float     @default(0)
  preferredCurrency   PreferredCurrency @default(SOL)
  rating              Float     @default(0)
  reviewCount         Int       @default(0)
  skills              String[]
  chains              String[]
  role                UserRole  @default(talent)
  isOnline            Boolean   @default(false)
  location            String?
  jobTypes            String[]
  completedJobsCount  Int       @default(0)
  totalEarnedSol      Float     @default(0)
  githubUrl           String?
  twitterUrl          String?
  isOnboarded         Boolean   @default(false)
  savedJobIds         String[]

  // Relations
  portfolio           PortfolioItem[]
  experience          Experience[]
  credentials         Credential[]
  documents           UserDocument[]

  posts               Post[]
  comments            PostComment[]
  postLikes           PostLike[]
  postReposts         PostRepost[]
  postBookmarks       PostBookmark[]

  jobsPosted          Job[]           @relation("JobPoster")
  applications        JobApplication[]

  sentConversations   Conversation[]  @relation("ConversationInitiator")
  receivedConversations Conversation[] @relation("ConversationParticipant")
  sentMessages        ChatMessage[]

  communityGroups     CommunityMember[]
  communityMessages   CommunityMessage[]

  notificationsReceived Notification[]

  reviewsGiven        Review[]        @relation("ReviewGiver")
  reviewsReceived     Review[]        @relation("ReviewReceivee")

  followers           Follow[]        @relation("FollowedUser")
  following           Follow[]        @relation("FollowingUser")

  commentLikes        CommentLike[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model PortfolioItem {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  imageUrl    String?
  description String?
  link        String?
  tags        String[]
  createdAt   DateTime @default(now())
}

model Experience {
  id              String   @id @default(uuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role            String
  company         String
  period          String
  description     String?
  verifiedOnChain Boolean  @default(false)
  txHash          String?
  createdAt       DateTime @default(now())
}

model Credential {
  id              String   @id @default(uuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  issuer          String
  issuedDate      String
  badgeIcon       String?
  verifiedOnChain Boolean  @default(false)
  txHash          String?
  createdAt       DateTime @default(now())
}

enum DocumentType {
  cv
  resume
  cover_letter
  certificate
  license
  degree
  other
}

model UserDocument {
  id              String       @id @default(uuid())
  profileId       String
  profile         Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type            DocumentType
  title           String
  fileName        String
  fileSize        String?
  fileUrl         String?
  isDefault       Boolean      @default(false)
  verifiedOnChain Boolean      @default(false)
  txHash          String?
  description     String?
  uploadedAt      DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    Profile  @relation("FollowingUser", fields: [followerId], references: [id], onDelete: Cascade)
  followedId  String
  followed    Profile  @relation("FollowedUser", fields: [followedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followedId])
}

// ─────────────────────────────────────────────
// POSTS / SOCIAL FEED
// ─────────────────────────────────────────────

enum PostType {
  general
  job_announcement
  portfolio_showcase
}

model Post {
  id            String    @id @default(uuid())
  authorId      String
  author        Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type          PostType  @default(general)
  content       String
  hashtags      String[]
  mediaUrls     String[]
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  repostsCount  Int       @default(0)
  jobId         String?
  budgetSol     Float?
  jobSkills     String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      PostComment[]
  likes         PostLike[]
  reposts       PostRepost[]
  bookmarks     PostBookmark[]
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  commentLikes CommentLike[]
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model CommentLike {
  id        String      @id @default(uuid())
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
}

model PostRepost {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostBookmark {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// ─────────────────────────────────────────────
// JOBS
// ─────────────────────────────────────────────

enum JobType {
  REMOTE
  HYBRID
  ON_SITE
}

enum ContractType {
  CONTRACT
  FULL_TIME
  PART_TIME
  MILESTONE_BASED
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model Job {
  id                   String       @id @default(uuid())
  posterId             String
  poster               Profile      @relation("JobPoster", fields: [posterId], references: [id], onDelete: Cascade)
  title                String
  posterCompany        String?
  jobType              JobType      @default(REMOTE)
  contractType         ContractType @default(CONTRACT)
  payRangeSol          String?
  budgetSol            Float        @default(0)
  skills               String[]
  chains               String[]
  description          String
  requirements         String[]
  applicantsCount      Int          @default(0)
  status               JobStatus    @default(OPEN)
  location             String?
  duration             String?
  category             String?
  tag                  String?
  rateDisplay          String?
  submissionDestination String?
  posterEmail          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  applications         JobApplication[]
}

enum ApplicationStatus {
  applied
  viewed
  shortlisted
  hired
  rejected
  paid
}

model JobApplication {
  id                   String            @id @default(uuid())
  jobId                String
  job                  Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId          String
  applicant            Profile           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter          String
  proposedRateSol      Float             @default(0)
  portfolioUrl         String?
  status               ApplicationStatus @default(applied)
  appliedAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// ─────────────────────────────────────────────
// CHAT (1-on-1 DMs)
// ─────────────────────────────────────────────

model Conversation {
  id            String        @id @default(uuid())
  initiatorId   String
  initiator     Profile       @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  participantId String
  participant   Profile       @relation("ConversationParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime      @default(now())

  messages      ChatMessage[]

  @@unique([initiatorId, participantId])
}

enum AttachmentType {
  image
  file
}

model ChatMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         Profile        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  attachmentUrl  String?
  attachmentType AttachmentType?
  read           Boolean        @default(false)
  createdAt      DateTime       @default(now())
}

// ─────────────────────────────────────────────
// COMMUNITIES
// ─────────────────────────────────────────────

enum CommunityIconType {
  announcement
  solana
  security
  rust
  design
  custom
}

model CommunityGroup {
  id            String            @id @default(uuid())
  name          String
  description   String?
  iconType      CommunityIconType @default(custom)
  iconBgColor   String?
  iconColor     String?
  isOfficial    Boolean           @default(false)
  isPinned      Boolean           @default(false)
  isLocked      Boolean           @default(false)
  category      String
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  members       CommunityMember[]
  messages      CommunityMessage[]
}

enum MemberRole {
  member
  admin
  creator
}

model CommunityMember {
  id        String         @id @default(uuid())
  groupId   String
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole     @default(member)
  status    String         @default("active") // active | pending
  createdAt DateTime       @default(now())

  @@unique([groupId, userId])
}

model CommunityMessage {
  id        String         @id @default(uuid())
  groupId   String
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Profile        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  likesCount Int           @default(0)
  isPinned  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

enum NotificationType {
  message
  job_status
  payment
  match
  like
  comment
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  amountTag String?
  isRead    Boolean          @default(false)
  linkTab   String?
  targetId  String?
  createdAt DateTime         @default(now())
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id              String   @id @default(uuid())
  jobId           String?
  jobTitle        String
  reviewerId      String
  reviewer        Profile  @relation("ReviewGiver", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId      String
  reviewee        Profile  @relation("ReviewReceivee", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating          Int      // 1–5
  comment         String
  verifiedOnChain Boolean  @default(false)
  txHash          String?
  createdAt       DateTime @default(now())
}
